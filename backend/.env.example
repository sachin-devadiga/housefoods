DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Render supplies DATABASE_URL automatically when linked to Render Postgres.
# For local PostgreSQL, set the following individual values instead.
# DATABASE_URL=postgresql://user:password@host:5432/mealin
DB_NAME=mealin
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Add these only if you deploy a browser frontend.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# Brevo SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_TLS=True
BREVO_SMTP_USER=your-brevo-login-email
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_FROM_EMAIL=noreply@mealin.app
