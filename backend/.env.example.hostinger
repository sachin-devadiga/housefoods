# MEALIN backend — Hostinger VPS environment template (api.mealin.in)
# On the VPS: cp .env.example.hostinger .env, then fill in the blank values.
# Never commit the real .env. Variable order matches the required .env exactly.
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.mealin.in
CSRF_TRUSTED_ORIGINS=https://api.mealin.in
CORS_ALLOWED_ORIGINS=
DATABASE_URL=
DB_NAME=mealin
DB_USER=mealin
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=mealin
POSTGRES_USER=mealin
POSTGRES_PASSWORD=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_TLS=True
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_NAME=Mealin
BREVO_SENDER_EMAIL=
BREVO_FROM_EMAIL=
BREVO_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
VOICE_API_THROTTLE=30/hour
JWT_ACCESS_TOKEN_LIFETIME_DAYS=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=90
SECURE_HSTS_SECONDS=31536000
APP_LATEST_VERSION=
APP_MIN_VERSION=
APP_UPDATE_URL=
APP_UPDATE_MESSAGE=
APP_FORCE_UPDATE=false
