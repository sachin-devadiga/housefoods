# MEALIN backend — GoDaddy cPanel environment reference (api.mealin.in)
# Copy these variable NAMES into cPanel (no values are stored here).
# Fill every value in cPanel; never commit real secrets.

DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.mealin.in
CSRF_TRUSTED_ORIGINS=https://api.mealin.in
CORS_ALLOWED_ORIGINS=

# GoDaddy MariaDB/MySQL — either full URL or individual parts
# Example: DATABASE_URL=mysql://mealin_user:password@localhost:3306/mealin_db
DATABASE_URL=
DB_NAME=mealin
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# Initial Django admin (used once by create_admin)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Brevo SMTP (OTP email)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_TLS=True
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_NAME=Mealin
BREVO_SENDER_EMAIL=
# Optional alternates used by the code: BREVO_FROM_EMAIL, BREVO_API_KEY, EMAIL_BACKEND

# MEAL AI chat
GEMINI_API_KEY=

# Voice STT proxy
SARVAM_API_KEY=

# Push notifications — either inline JSON or uploaded file path
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional tuning
VOICE_API_THROTTLE=30/hour
JWT_ACCESS_TOKEN_LIFETIME_DAYS=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=90
SECURE_HSTS_SECONDS=31536000
APP_LATEST_VERSION=
APP_MIN_VERSION=
APP_UPDATE_URL=
APP_UPDATE_MESSAGE=
APP_FORCE_UPDATE=false
