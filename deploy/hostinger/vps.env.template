# MEALIN backend — Hostinger VPS environment (api.mealin.in)
#
#   cp vps.env.template backend/.env    # on the VPS
#   nano backend/.env                   # fill every REPLACE_ line
#
# Unlike .env.example.hostinger, DATABASE_URL here is PRE-FILLED. That is the
# single most common way this deployment fails: settings.py:163 loads
# dj_database_url when DATABASE_URL is set, but falls back to the hardcoded
# MySQL engine when it is empty. Leave it blank and Django will try to speak
# MySQL to the Postgres container and refuse to start.
#
# Secrets marked REPLACE_ are copied from your laptop's backend/.env. The key
# in parentheses is the variable to copy FROM. Nothing here is a real value.

# ---------- Django core ----------
DJANGO_SECRET_KEY=REPLACE_generate_with_python3_c_secrets_token_urlsafe_50
DEBUG=False
ALLOWED_HOSTS=api.mealin.in
CSRF_TRUSTED_ORIGINS=https://api.mealin.in
# Only needed for a browser client (Flutter web). The APK is not a CORS origin.
CORS_ALLOWED_ORIGINS=

# ---------- Database ----------
# 'db' is the docker-compose service name, NOT localhost. Postgres is not
# published to the host, so 127.0.0.1:5432 will not connect.
DATABASE_URL=postgres://mealin:REPLACE_DB_PASSWORD@db:5432/mealin
# Read by the db service in docker-compose.yml, not by Django.
POSTGRES_DB=mealin
POSTGRES_USER=mealin
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD

# ---------- Admin ----------
# create_admin only acts if no superuser exists yet.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=REPLACE_your_email
DJANGO_SUPERUSER_PASSWORD=REPLACE_a_strong_password

# ---------- Brevo (OTP email) ----------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_TLS=True
BREVO_SMTP_USER=REPLACE_        (copy BREVO_SMTP_USER)
BREVO_SMTP_PASSWORD=REPLACE_    (copy BREVO_SMTP_PASSWORD)
BREVO_SENDER_NAME=Mealin
BREVO_SENDER_EMAIL=REPLACE_    (copy BREVO_SENDER_EMAIL)
BREVO_FROM_EMAIL=REPLACE_       (copy BREVO_FROM_EMAIL)
BREVO_API_KEY=REPLACE_          (copy BREVO_API_KEY)

# NOTE: if OTP emails never arrive, check this first —
# https://app.brevo.com/security/authorised_ips
# whitelist the VPS public IP, or remove the restriction entirely. A VPS has one
# stable IP, which is exactly what that allowlist needs.

# ---------- Third-party AI ----------
GEMINI_API_KEY=REPLACE_          (copy GEMINI_API_KEY)
SARVAM_API_KEY=REPLACE_          (copy SARVAM_API_KEY)

# ---------- Firebase (push notifications) ----------
# Inline JSON, single line, escaped quotes kept as-is. .dockerignore excludes
# firebase-service-account.json from the image, so the env var is the ONLY
# working path. Copy the whole FIREBASE_SERVICE_ACCOUNT value.
FIREBASE_SERVICE_ACCOUNT=REPLACE_
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------- Tuning ----------
VOICE_API_THROTTLE=30/hour
JWT_ACCESS_TOKEN_LIFETIME_DAYS=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=90
SECURE_HSTS_SECONDS=31536000