<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug-only manifest merge.

         src/main/AndroidManifest.xml sets usesCleartextTraffic="false" so the
         release build that ships to Google Play cannot make plaintext requests.
         That breaks local development, where start_backend.sh serves Django on
         http://localhost:8000 and run_dev.sh points the app at it using the
         API_BASE_URL dart-define.

         This file is merged ONLY into debug builds. tools:replace is required
         because the attribute is already declared with a conflicting value in
         the main manifest; without it the manifest merger fails outright. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>